<%- include('partials/header', { title, page }) %>

<div class="main-container">
  <header class="app-header">
    <h1 class="app-title">QuickShare</h1>
  </header>

  <div class="card error-card">
    <div class="error-icon">
      <i class="fas fa-exclamation-triangle" aria-hidden="true"></i>
    </div>
    <h2 class="error-title"><%= title %></h2>
    <p class="error-message"><%= message %></p>
    <a href="/" class="back-btn">
      <i class="fas fa-arrow-left" aria-hidden="true"></i> 返回首页
    </a>
  </div>
  
  <footer class="app-footer">
    <p class="footer-text">&copy;2026 <a href="https://x.com/nardinmarcus" target="_blank" rel="noopener noreferrer">Namoo</a></p>
  </footer>
</div>

<%- include('partials/footer', { page }) %>
