<%- include('partials/header', { title, page }) %>

<div class="admin-container">
  <header class="admin-header">
    <div>
      <h1 class="admin-title">审计日志</h1>
      <p class="admin-subtitle">已记录 <%= pagination.total %> 条操作事件</p>
    </div>
    <%- include('partials/admin-nav', { current: 'audit' }) %>
  </header>

  <section class="card admin-card">
    <% if (logs.length === 0) { %>
      <div class="admin-empty">
        <p>暂无审计事件。</p>
      </div>
    <% } else { %>
      <div class="admin-table-wrap" tabindex="0" aria-label="审计日志，可横向滚动">
        <table class="admin-table admin-audit-table">
          <caption class="sr-only">审计日志</caption>
          <thead>
            <tr>
              <th scope="col">时间</th>
              <th scope="col">操作</th>
              <th scope="col">分享 ID</th>
              <th scope="col">详情</th>
              <th scope="col">IP 地址</th>
            </tr>
          </thead>
          <tbody>
            <%
              const auditActionLabels = {
                'admin.login': '后台登录',
                'api_key.create': '创建密钥',
                'api_key.delete': '删除密钥',
                'api_key.rotate': '轮换密钥',
                'api_key.scopes': '修改密钥范围',
                'api_key.grant': '授予 Share 权限',
                'api_key.grant_revoke': '撤销 Share 权限',
                'api_key.auto_grant': '修改自动授权',
                'page.create': '创建分享',
                'page.update': '更新分享',
                'page.content.update': '更新内容',
                'page.delete': '删除分享',
                'page.delete.batch': '批量删除分享',
                'page.clone': '克隆分享',
                'page.publish.update': '上下架状态更新',
                'page.access.revoke': '撤销已解锁访问',
                'page.revision.purge': '清除历史版本',
                'settings.homepage_password_required.update': '修改首页访问控制',
                'share.create': 'API 创建分享',
                'share.content.update': 'API 更新内容',
                'share.clone': 'API 克隆分享',
                'share.restore': 'API 恢复版本'
              };
            %>
            <% logs.forEach((log) => { %>
              <% const isFavoriteUpdate = log.action === 'page.favorite.update'; %>
              <tr>
                <td><time datetime="<%= new Date(log.createdAt).toISOString() %>"><%= formatManagementDateTime(log.createdAt) %></time></td>
                <td><span class="admin-audit-badge <%= isFavoriteUpdate ? 'favorite-share-update' : log.action %>" title="<%= log.action %>"><%= isFavoriteUpdate ? 'Favorite Share 状态更新' : (auditActionLabels[log.action] || log.action) %></span></td>
                <td>
                  <% if (log.pageId) { %>
                    <a href="/admin/pages/<%= encodeURIComponent(log.pageId) %>"><%= log.pageId %></a>
                  <% } else { %>
                    <span class="admin-muted">—</span>
                  <% } %>
                </td>
                <td>
                  <% if (log.details) { %>
                    <code class="admin-password-value admin-audit-details"><%= log.details %></code>
                  <% } else { %>
                    <span class="admin-muted">—</span>
                  <% } %>
                </td>
                <td><span class="admin-muted"><%= log.ip || '—' %></span></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>

      <nav class="admin-pagination" aria-label="审计日志分页">
        <% if (pagination.hasPrevious) { %>
          <a class="cyber-btn cyber-btn-secondary" href="/admin/audit?page=<%= pagination.page - 1 %>">上一页</a>
        <% } else { %>
          <span class="cyber-btn cyber-btn-secondary disabled" aria-disabled="true">上一页</span>
        <% } %>
        <span class="admin-page-count">第 <%= pagination.page %> / <%= pagination.totalPages %> 页</span>
        <% if (pagination.hasNext) { %>
          <a class="cyber-btn cyber-btn-secondary" href="/admin/audit?page=<%= pagination.page + 1 %>">下一页</a>
        <% } else { %>
          <span class="cyber-btn cyber-btn-secondary disabled" aria-disabled="true">下一页</span>
        <% } %>
      </nav>
    <% } %>
  </section>
</div>

<%- include('partials/footer', { page }) %>
