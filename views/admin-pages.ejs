<%- include('partials/header', { title, page, csrfToken }) %>
<%
  const typeLabel = filters.type || '类型';
  const statusLabel = filters.status === 'public' ? '公开' : (filters.status === 'protected' ? '密码保护' : '状态');
  const sortOptions = [
    { sort: 'created_at', order: 'desc', label: '创建时间，从新到旧' },
    { sort: 'created_at', order: 'asc', label: '创建时间，从旧到新' },
    { sort: 'code_type', order: 'asc', label: '按类型' },
    { sort: 'is_protected', order: 'desc', label: '按状态' }
  ];
  const activeSort = sortOptions.find((option) => option.sort === filters.sort && (option.sort !== 'created_at' || option.order === filters.order)) || sortOptions[0];
  const hasDateFilter = Boolean(filters.dateFrom || filters.dateTo);
%>

<div class="admin-container" id="admin-pages-context" data-admin-pages-url="<%= favoriteRefreshUrl %>">
  <header class="admin-header">
    <div class="admin-heading">
      <h1 class="admin-title">分享</h1>
      <p class="admin-subtitle">共 <%= pagination.total %> 个分享</p>
    </div>
    <%- include('partials/admin-nav', { current: 'pages' }) %>
  </header>

  <% if (!hasAnyPages) { %>
    <div class="admin-empty">
      <h2>还没有分享</h2>
      <p>可以从首页或 Share API 创建第一个分享。</p>
      <a class="cyber-btn cyber-btn-primary" href="/">新建分享</a>
    </div>
  <% } else { %>
    <div class="share-toolbar">
      <form class="share-search" id="admin-search-form" method="get" action="/admin/pages" role="search">
        <i class="fas fa-search" aria-hidden="true"></i>
        <input
          type="search"
          id="admin-search-input"
          name="search"
          value="<%= filters.search %>"
          placeholder="按标题、ID 或描述搜索"
          aria-label="搜索分享"
        >
        <% if (filters.type) { %><input type="hidden" name="type" value="<%= filters.type %>"><% } %>
        <% if (filters.status) { %><input type="hidden" name="status" value="<%= filters.status %>"><% } %>
        <% if (filters.favorite) { %><input type="hidden" name="favorite" value="true"><% } %>
        <input type="hidden" name="sort" value="<%= filters.sort %>">
        <input type="hidden" name="order" value="<%= filters.order %>">
        <% if (filters.dateFrom) { %><input type="hidden" name="dateFrom" value="<%= filters.dateFrom %>"><% } %>
        <% if (filters.dateTo) { %><input type="hidden" name="dateTo" value="<%= filters.dateTo %>"><% } %>
        <button type="submit" class="sr-only">搜索</button>
        <% if (filters.search) { %>
          <a class="text-control share-search-clear" href="<%= adminPagesUrl({ search: '', page: '' }) %>">清除</a>
        <% } %>
      </form>

      <div class="share-filters">
        <details class="menu" data-menu>
          <summary class="chip <%= filters.type ? 'is-active' : '' %>"><span><%= typeLabel %></span><i class="fas fa-chevron-down" aria-hidden="true"></i></summary>
          <div class="menu-panel">
            <a class="menu-item" href="<%= adminPagesUrl({ type: '', page: '' }) %>" <% if (!filters.type) { %>aria-current="true"<% } %>>全部类型</a>
            <% ['html', 'markdown', 'svg', 'mermaid'].forEach(function(t) { %>
              <a class="menu-item" href="<%= adminPagesUrl({ type: t, page: '' }) %>" <% if (filters.type === t) { %>aria-current="true"<% } %>><%= t %></a>
            <% }); %>
          </div>
        </details>

        <details class="menu" data-menu>
          <summary class="chip <%= filters.status ? 'is-active' : '' %>"><span><%= statusLabel %></span><i class="fas fa-chevron-down" aria-hidden="true"></i></summary>
          <div class="menu-panel">
            <a class="menu-item" href="<%= adminPagesUrl({ status: '', page: '' }) %>" <% if (!filters.status) { %>aria-current="true"<% } %>>全部状态</a>
            <a class="menu-item" href="<%= adminPagesUrl({ status: 'public', page: '' }) %>" <% if (filters.status === 'public') { %>aria-current="true"<% } %>>公开</a>
            <a class="menu-item" href="<%= adminPagesUrl({ status: 'protected', page: '' }) %>" <% if (filters.status === 'protected') { %>aria-current="true"<% } %>>密码保护</a>
          </div>
        </details>

        <details class="menu menu-end" data-menu>
          <summary class="chip chip-icon <%= filters.favorite ? 'is-active' : '' %>" aria-label="收藏筛选" title="收藏筛选"><i class="<%= filters.favorite ? 'fas' : 'far' %> fa-star" aria-hidden="true"></i></summary>
          <div class="menu-panel">
            <a class="menu-item" href="<%= adminPagesUrl({ favorite: '', page: '' }) %>" <% if (!filters.favorite) { %>aria-current="true"<% } %>>全部 Shares</a>
            <a class="menu-item" href="<%= adminPagesUrl({ favorite: 'true', page: '' }) %>" <% if (filters.favorite) { %>aria-current="true"<% } %>>Favorite Shares</a>
          </div>
        </details>
      </div>
    </div>

    <div class="share-options">
      <details class="menu" data-menu>
        <summary class="text-control"><span>排序：<%= activeSort.label %></span><i class="fas fa-chevron-down" aria-hidden="true"></i></summary>
        <div class="menu-panel">
          <% sortOptions.forEach(function(option) { %>
            <a class="menu-item" href="<%= adminPagesUrl({ sort: option.sort, order: option.order, page: '' }) %>" <% if (option === activeSort) { %>aria-current="true"<% } %>><%= option.label %></a>
          <% }); %>
        </div>
      </details>

      <span class="share-options-end">
        <button type="button" class="text-control" id="select-mode-btn" aria-pressed="false">选择</button>

        <details class="menu menu-end" data-menu>
          <summary class="text-control <%= hasDateFilter ? 'is-active' : '' %>"><span>更多</span><i class="fas fa-chevron-down" aria-hidden="true"></i></summary>
          <div class="menu-panel menu-panel-wide">
            <p class="menu-label">创建日期</p>
            <div class="admin-date-range">
              <input type="date" id="filter-date-from" value="<%= filters.dateFrom || '' %>" aria-label="开始日期">
              <span aria-hidden="true">至</span>
              <input type="date" id="filter-date-to" value="<%= filters.dateTo || '' %>" aria-label="结束日期">
            </div>
            <div class="menu-row">
              <button type="button" class="cyber-btn cyber-btn-secondary" id="date-filter-btn">筛选</button>
              <% if (hasDateFilter) { %>
                <a class="text-control" href="<%= adminPagesUrl({ dateFrom: '', dateTo: '', page: '' }) %>">清除日期</a>
              <% } %>
            </div>

            <p class="menu-label">行高</p>
            <div class="segmented" role="group" aria-label="行高">
              <button type="button" data-density-option="comfortable" aria-pressed="true">宽松</button>
              <button type="button" data-density-option="compact" aria-pressed="false">紧凑</button>
            </div>

            <a class="menu-item" href="/admin/pages/export" title="仅包含分享元信息，不含正文，不能用于恢复；完整备份见 docs/backup-restore.md">
              <i class="fas fa-download" aria-hidden="true"></i>
              <span>导出清单（不含正文）</span>
            </a>
          </div>
        </details>
      </span>
    </div>

    <% if (pages.length === 0) { %>
      <div class="admin-empty">
        <p>没有符合条件的分享，<a href="/admin/pages">清除全部筛选条件</a>。</p>
      </div>
    <% } else { %>
      <div class="share-groups" id="share-list" data-density="comfortable" data-selecting="false">
        <% const now = Date.now(); %>
        <% groups.forEach((group, groupIndex) => { %>
          <section class="share-group" aria-labelledby="share-group-<%= groupIndex %>">
            <h2 class="share-group-title" id="share-group-<%= groupIndex %>"><%= group.label %></h2>
            <ul class="share-list">
              <% group.pages.forEach((sharedPage) => { %>
                <%
                  const isExpired = sharedPage.expires_at && Number(sharedPage.expires_at) < now;
                  const isExpiringSoon = sharedPage.expires_at && !isExpired && Number(sharedPage.expires_at) < now + 24 * 60 * 60 * 1000;
                  const isUnpublished = sharedPage.published === false;
                  const shareName = sharedPage.title || sharedPage.id;
                %>
                <li class="share-row <%= isUnpublished ? 'is-unpublished' : '' %> <%= isExpired ? 'admin-expired' : '' %> <%= isExpiringSoon ? 'admin-expiring' : '' %>" data-page-id="<%= sharedPage.id %>">
                  <label class="share-check admin-checkbox-target">
                    <input type="checkbox" class="row-checkbox" data-id="<%= sharedPage.id %>">
                    <span class="sr-only">选择 <%= shareName %></span>
                  </label>
                  <span class="share-type" title="<%= sharedPage.code_type || 'html' %>"><%= shareTypeAbbreviation(sharedPage.code_type) %></span>
                  <div class="share-main">
                    <a class="share-title admin-page-title" href="/admin/pages/<%= encodeURIComponent(sharedPage.id) %>"><%= shareName %></a>
                    <p class="share-meta">
                      <% if (isUnpublished) { %><span>已下架</span><% } %>
                      <span><%= sharedPage.is_protected === 1 ? '密码保护' : '公开' %></span>
                      <% if (sharedPage.is_protected === 1 && sharedPage.visiblePassword) { %>
                        <code class="admin-password-value"><%= sharedPage.visiblePassword %></code>
                      <% } else if (sharedPage.is_protected === 1) { %>
                        <span>密码不可查看</span>
                      <% } %>
                      <span><%= sharedPage.view_count || 0 %> 次访问</span>
                      <% if (isExpired) { %>
                        <span class="admin-expired-badge">已过期</span>
                      <% } else if (isExpiringSoon) { %>
                        <span class="admin-expiring-badge">即将过期</span>
                      <% } %>
                      <% if (sharedPage.description) { %><span class="admin-page-description"><%= sharedPage.description %></span><% } %>
                    </p>
                  </div>
                  <time class="share-time" datetime="<%= new Date(Number(sharedPage.created_at)).toISOString() %>" title="<%= formatManagementDateTime(sharedPage.created_at) %>"><%= formatShareListTime(sharedPage.created_at, now) %></time>
                  <div class="share-actions">
                    <a class="icon-btn" href="<%= publicPageUrl(sharedPage.id) %>" target="_blank" rel="noopener noreferrer" aria-label="打开公开页面 <%= shareName %>" title="打开公开页面">
                      <i class="fas fa-external-link-alt" aria-hidden="true"></i>
                    </a>
                    <button
                      type="button"
                      class="icon-btn admin-favorite-toggle admin-list-favorite-toggle"
                      data-favorite-toggle
                      data-page-id="<%= sharedPage.id %>"
                      data-page-title="<%= shareName %>"
                      data-is-favorite="<%= sharedPage.is_favorite ? 'true' : 'false' %>"
                      <% if (filters.favorite) { %>data-refresh-url="<%= favoriteRefreshUrl %>"<% } %>
                      aria-pressed="<%= sharedPage.is_favorite ? 'true' : 'false' %>"
                      aria-busy="false"
                      aria-label="<%= sharedPage.is_favorite ? `取消收藏 ${shareName}` : `收藏分享 ${shareName}` %>"
                    >
                      <i class="<%= sharedPage.is_favorite ? 'fas' : 'far' %> fa-star admin-favorite-icon" aria-hidden="true"></i>
                      <span class="sr-only admin-favorite-label"><%= sharedPage.is_favorite ? '取消收藏' : '收藏' %></span>
                    </button>
                    <button
                      type="button"
                      class="icon-btn admin-publish-toggle"
                      data-publish-toggle
                      data-page-id="<%= sharedPage.id %>"
                      data-page-title="<%= shareName %>"
                      data-published="<%= isUnpublished ? 'false' : 'true' %>"
                      data-access-revision="<%= sharedPage.access_revision || '1' %>"
                      aria-pressed="<%= isUnpublished ? 'false' : 'true' %>"
                      aria-label="<%= isUnpublished ? `重新发布分享 ${shareName}` : `下架分享 ${shareName}` %>"
                      title="<%= isUnpublished ? '重新发布' : '下架' %>"
                    >
                      <i class="<%= isUnpublished ? 'fas fa-eye' : 'fas fa-eye-slash' %>" aria-hidden="true"></i>
                    </button>
                    <form method="post" action="/admin/pages/<%= encodeURIComponent(sharedPage.id) %>/clone" class="admin-inline-form">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                      <button type="submit" class="icon-btn admin-clone-btn" aria-label="克隆分享 <%= shareName %>" title="克隆">
                        <i class="fas fa-copy" aria-hidden="true"></i>
                      </button>
                    </form>
                    <button
                      type="button"
                      class="icon-btn admin-delete-btn"
                      data-page-id="<%= sharedPage.id %>"
                      data-page-title="<%= shareName %>"
                      aria-label="删除分享 <%= shareName %>"
                      title="删除"
                    >
                      <i class="fas fa-trash-alt" aria-hidden="true"></i>
                    </button>
                  </div>
                </li>
              <% }) %>
            </ul>
          </section>
        <% }) %>
      </div>

      <div id="batch-toolbar" class="batch-toolbar" role="region" aria-label="批量操作" hidden>
        <label class="admin-checkbox-target batch-select-all">
          <input type="checkbox" id="select-all">
          <span>全选本页</span>
        </label>
        <span id="batch-count" aria-live="polite">已选择 0 项</span>
        <button type="button" class="cyber-btn cyber-btn-danger" id="batch-delete-btn" disabled>
          <i class="fas fa-trash-alt" aria-hidden="true"></i>
          <span>删除所选</span>
        </button>
        <button type="button" class="cyber-btn cyber-btn-secondary" id="batch-cancel-btn">取消</button>
      </div>

      <nav class="admin-pagination" aria-label="分享列表分页">
        <% if (pagination.hasPrevious) { %>
          <a class="text-control" href="<%= adminPagesUrl({ page: pagination.page - 1 }) %>">上一页</a>
        <% } else { %>
          <span class="text-control disabled" aria-disabled="true">上一页</span>
        <% } %>
        <span class="admin-page-count">第 <%= pagination.page %> / <%= pagination.totalPages %> 页</span>
        <% if (pagination.totalPages > 1) { %>
        <span class="admin-page-jump">
          <label class="sr-only" for="jump-page-input">跳转到页码</label>
          <input type="number" id="jump-page-input" min="1" max="<%= pagination.totalPages %>" placeholder="页码" aria-label="跳转到页码">
          <button type="button" class="text-control" id="jump-page-btn">前往</button>
        </span>
        <% } %>
        <% if (pagination.hasNext) { %>
          <a class="text-control" href="<%= adminPagesUrl({ page: pagination.page + 1 }) %>">下一页</a>
        <% } else { %>
          <span class="text-control disabled" aria-disabled="true">下一页</span>
        <% } %>
      </nav>
    <% } %>
  <% } %>
</div>

<div id="delete-modal" class="admin-modal" role="dialog" aria-modal="true" aria-labelledby="delete-modal-title" aria-describedby="delete-modal-description" aria-busy="false" hidden>
  <div class="admin-modal-backdrop" aria-hidden="true"></div>
  <div class="admin-modal-content" tabindex="-1">
    <h3 id="delete-modal-title">确认删除</h3>
    <p id="delete-modal-description">确定要删除 <strong id="delete-modal-target"></strong> 吗？</p>
    <p class="admin-modal-warning">此操作无法撤销。</p>
    <p id="delete-modal-status" class="admin-modal-status" role="status" aria-live="polite" aria-atomic="true" tabindex="-1"></p>
    <div class="admin-modal-actions">
      <button type="button" class="cyber-btn cyber-btn-secondary" id="delete-modal-cancel">取消</button>
      <button type="button" class="cyber-btn cyber-btn-danger" id="delete-modal-confirm">删除</button>
    </div>
  </div>
</div>

<script src="/js/admin.js"></script>
<script src="/js/admin-favorite.js"></script>
<script src="/js/admin-list.js"></script>
<%- include('partials/footer', { page }) %>
