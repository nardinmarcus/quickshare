<%- include('partials/header', { title, page, csrfToken }) %>

<div class="admin-container">
  <header class="admin-header">
    <div>
      <p class="admin-kicker">分享详情</p>
      <h1 class="admin-title" id="page-title-display"><%= sharedPage.title || sharedPage.id %></h1>
      <p class="admin-subtitle"><%= sharedPage.id %></p>
    </div>
    <%- include('partials/admin-nav', { current: 'pages' }) %>
  </header>

  <div class="admin-detail-actions">
    <button
      type="button"
      class="cyber-btn cyber-btn-secondary admin-favorite-toggle"
      data-favorite-toggle
      data-page-id="<%= sharedPage.id %>"
      data-page-title="<%= sharedPage.title || sharedPage.id %>"
      data-is-favorite="<%= sharedPage.isFavorite ? 'true' : 'false' %>"
      aria-pressed="<%= sharedPage.isFavorite ? 'true' : 'false' %>"
      aria-busy="false"
      aria-label="<%= sharedPage.isFavorite ? `取消收藏 ${sharedPage.title || sharedPage.id}` : `收藏分享 ${sharedPage.title || sharedPage.id}` %>"
    >
      <i class="<%= sharedPage.isFavorite ? 'fas' : 'far' %> fa-star admin-favorite-icon" aria-hidden="true"></i>
      <span class="admin-favorite-label"><%= sharedPage.isFavorite ? '取消收藏' : '收藏' %></span>
    </button>
    <button type="button" class="cyber-btn cyber-btn-secondary" id="edit-toggle-btn">
      <i class="fas fa-pen" aria-hidden="true"></i>
      <span>编辑</span>
    </button>
    <% if (sharedPage.isProtected) { %>
    <button type="button" class="cyber-btn cyber-btn-secondary" id="revoke-access-btn">
      <i class="fas fa-ban" aria-hidden="true"></i>
      <span>撤销已解锁访问</span>
    </button>
    <% } %>
    <form method="post" action="/admin/pages/<%= encodeURIComponent(sharedPage.id) %>/clone" class="admin-inline-form">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <button type="submit" class="cyber-btn cyber-btn-secondary">
        <i class="fas fa-copy" aria-hidden="true"></i>
        <span>克隆</span>
      </button>
    </form>
    <a class="cyber-btn cyber-btn-secondary admin-home-link" href="/admin/pages">
      <i class="fas fa-arrow-left" aria-hidden="true"></i>
      <span>返回列表</span>
    </a>
  </div>

  <section class="card admin-card">
    <dl class="admin-detail-grid">
      <div>
        <dt>公开链接</dt>
        <dd><a href="<%= publicUrl %>" target="_blank" rel="noopener noreferrer"><%= publicUrl %></a></dd>
      </div>
      <div>
        <dt>类型</dt>
        <dd><span class="admin-pill"><%= sharedPage.codeType || 'html' %></span></dd>
      </div>
      <div>
        <dt>创建时间</dt>
        <dd><time datetime="<%= new Date(Number(sharedPage.createdAt)).toISOString() %>"><%= formatManagementDateTime(sharedPage.createdAt) %></time></dd>
      </div>
      <div>
        <dt>内容版本</dt>
        <dd id="content-revision-display">
          <% if (sharedPage.currentRevision) { %>
            <span>Revision <%= sharedPage.currentRevision %></span>
            <code class="admin-etag-value"><%= sharedPage.contentEtag %></code>
          <% } else { %>
            <span class="admin-muted">尚未建立基线版本</span>
          <% } %>
        </dd>
      </div>
      <div>
        <dt>发布状态</dt>
        <dd id="published-display">
          <% if (sharedPage.published) { %>
            <span class="admin-status public">已发布</span>
          <% } else { %>
            <span class="admin-status protected">已下架</span>
          <% } %>
        </dd>
      </div>
      <div>
        <dt>状态</dt>
        <dd id="status-display">
          <% if (sharedPage.isProtected) { %>
            <span class="admin-status protected">密码保护</span>
          <% } else { %>
            <span class="admin-status public">公开</span>
          <% } %>
        </dd>
      </div>
      <div id="password-display-row" <%= !sharedPage.isProtected ? 'hidden' : '' %>>
        <dt>密码</dt>
        <dd id="password-display">
          <% if (sharedPage.password) { %>
            <code class="admin-password-value"><%= sharedPage.password %></code>
          <% } else { %>
            <span class="admin-muted">旧版分享无法查看密码</span>
          <% } %>
        </dd>
      </div>
      <div id="expires-display-row" <%= !sharedPage.expiresAt ? 'hidden' : '' %>>
        <dt>过期时间</dt>
        <dd id="expires-display">
          <% if (sharedPage.expiresAt) { %>
            <time datetime="<%= new Date(Number(sharedPage.expiresAt)).toISOString() %>"><%= formatManagementDateTime(sharedPage.expiresAt) %></time>
          <% } else { %>
            <span class="admin-muted">永不过期</span>
          <% } %>
        </dd>
      </div>
      <div class="admin-detail-wide" id="description-display-row" <%= !sharedPage.description ? 'hidden' : '' %>>
        <dt>描述</dt>
        <dd id="description-display"><%= sharedPage.description || '' %></dd>
      </div>
    </dl>

    <form id="edit-form" class="admin-edit-form" aria-busy="false" hidden>
      <fieldset class="admin-edit-group" id="content-fields">
        <legend>内容</legend>
        <div class="admin-edit-grid">
        <div class="admin-edit-field">
          <label for="edit-title">标题</label>
          <input type="text" id="edit-title" name="title" value="<%= sharedPage.title || '' %>" maxlength="200">
        </div>
        <div class="admin-edit-field">
          <label for="edit-description">描述</label>
          <textarea id="edit-description" name="description" rows="2" maxlength="500"><%= sharedPage.description || '' %></textarea>
        </div>
        <% if (sharedPage.codeType === 'markdown') { %>
          <%- include('partials/theme-sampler', {
            containerId: 'theme-field',
            containerClass: 'admin-edit-field',
            selectId: 'edit-theme',
            selectedThemeId: sharedPage.markdownTheme,
            markdownThemeOptions
          }) %>
        <% } %>
        </div>
        <p class="admin-edit-hint">正文在下方“原始内容”中编辑；内容保存以当前内容版本为前置条件，版本冲突时你的稿件会被保留并展示差异。</p>
        <div class="admin-edit-actions">
          <button type="submit" class="cyber-btn" id="edit-save-content" data-save-family="content">保存内容</button>
        </div>
      </fieldset>
      <fieldset class="admin-edit-group" id="access-fields">
        <legend>访问设置</legend>
        <div class="admin-edit-grid">
        <div class="admin-edit-field">
          <label for="edit-expires">过期时间（北京时间）</label>
          <input
            type="datetime-local"
            id="edit-expires"
            name="expiresAt"
            step="0.001"
            value="<%= sharedPage.expiresAt ? toManagementDateTimeLocal(sharedPage.expiresAt) : '' %>"
          >
          <button type="button" class="admin-clear-btn" id="clear-expires">清除</button>
          <span id="edit-expires-hint" class="field-hint" aria-live="polite"></span>
        </div>
        <div class="admin-edit-field">
          <label class="admin-toggle-label">
            <input type="checkbox" id="edit-protected" name="isProtected" <%= sharedPage.isProtected ? 'checked' : '' %>>
            <span class="admin-toggle-slider"></span>
            <span class="admin-toggle-text">密码保护</span>
          </label>
          <div class="admin-password-input-wrap" id="password-input-wrap" <%= !sharedPage.isProtected ? 'hidden' : '' %>>
            <label for="edit-password">自定义密码</label>
            <div class="admin-password-input-group">
              <input
                type="password"
                id="edit-password"
                name="password"
                placeholder="留空则保持当前密码或自动生成"
                minlength="4"
                maxlength="12"
                autocomplete="new-password"
                aria-describedby="edit-password-hint password-input-description"
                aria-invalid="false"
              >
              <button type="button" class="admin-toggle-password-btn" id="toggle-password-visibility" aria-label="显示密码">
                <i class="fas fa-eye" aria-hidden="true"></i>
              </button>
            </div>
            <span id="edit-password-hint" class="field-hint" aria-live="polite"></span>
            <p class="admin-edit-hint" id="password-input-description">留空时：已有保护保持当前密码，新开启保护自动生成 6 位数字密码。</p>
          </div>
          <p class="admin-edit-hint" id="protection-hint" aria-live="polite">
            <% if (sharedPage.isProtected) { %>
              取消勾选将移除密码保护。
            <% } else { %>
              勾选后将启用密码保护。
            <% } %>
          </p>
        </div>
        </div>
        <div class="admin-edit-actions">
          <button type="submit" class="cyber-btn" id="edit-save-access" data-save-family="access">保存访问设置</button>
        </div>
      </fieldset>
      <div class="admin-edit-actions">
        <button type="button" class="cyber-btn cyber-btn-secondary" id="edit-cancel">取消</button>
      </div>
    </form>
  </section>

  <section class="card admin-card admin-conflict" id="content-conflict" hidden>
    <h2 class="admin-conflict-title">内容版本冲突</h2>
    <p id="conflict-message" role="alert">远端内容已经更新，你的稿件没有被覆盖。下面是远端最新版与你的稿件之间的差异，请决定如何处理。</p>
    <table class="admin-conflict-meta" id="conflict-meta" hidden>
      <thead>
        <tr><th scope="col">字段</th><th scope="col">远端最新版</th><th scope="col">我的稿件</th></tr>
      </thead>
      <tbody id="conflict-meta-body"></tbody>
    </table>
    <p id="conflict-diff-status" aria-live="polite"></p>
    <div class="admin-conflict-diff" id="conflict-diff" aria-label="正文行级差异"></div>
    <details class="admin-conflict-full">
      <summary>查看远端最新版完整正文</summary>
      <pre id="conflict-remote-full"></pre>
    </details>
    <details class="admin-conflict-full">
      <summary>查看我的稿件完整正文</summary>
      <pre id="conflict-candidate-full"></pre>
    </details>
    <div class="admin-edit-actions">
      <button type="button" class="cyber-btn cyber-btn-secondary" id="conflict-load-remote">放弃我的稿件，加载远端最新版</button>
      <button type="button" class="cyber-btn" id="conflict-save-mine">以我的版本保存</button>
    </div>
  </section>

  <section class="card admin-card" id="history-section">
    <h2 class="admin-section-title">历史版本</h2>
    <p class="admin-history-note">浏览此分享的内容历史：可查看单个版本的源码与预览、比较任意两个版本，并将某个版本恢复为新的当前版本。恢复只改内容，不改变密码、有效期等访问策略。此处不提供清除操作。</p>
    <p id="history-status" aria-live="polite">正在加载历史…</p>
    <button type="button" class="cyber-btn cyber-btn-secondary" id="history-retry" hidden>重试</button>
    <div id="history-list"></div>
    <div class="admin-history-pager" id="history-pager" hidden>
      <button type="button" class="cyber-btn cyber-btn-secondary" id="history-prev">上一页</button>
      <span id="history-page-info"></span>
      <button type="button" class="cyber-btn cyber-btn-secondary" id="history-next">下一页</button>
    </div>
    <div class="admin-history-compare-bar" id="history-compare-bar" hidden>
      <span id="history-compare-selection"></span>
      <button type="button" class="cyber-btn" id="history-compare-run">比较所选版本</button>
      <button type="button" class="cyber-btn cyber-btn-secondary" id="history-compare-clear">清除选择</button>
    </div>
    <div id="history-compare-result" hidden>
      <h3 class="admin-history-subtitle">版本比较 <span id="history-compare-title"></span></h3>
      <table class="admin-conflict-meta" id="history-compare-meta" hidden>
        <thead>
          <tr><th scope="col">字段</th><th scope="col">旧版</th><th scope="col">新版</th></tr>
        </thead>
        <tbody id="history-compare-meta-body"></tbody>
      </table>
      <p id="history-compare-status" aria-live="polite"></p>
      <div class="admin-conflict-diff" id="history-compare-diff" aria-label="正文行级差异"></div>
      <details class="admin-conflict-full">
        <summary>查看旧版完整正文</summary>
        <pre id="history-compare-before-full"></pre>
      </details>
      <details class="admin-conflict-full">
        <summary>查看新版完整正文</summary>
        <pre id="history-compare-after-full"></pre>
      </details>
    </div>
    <div id="history-source" hidden>
      <h3 class="admin-history-subtitle">版本源码 <span id="history-source-title"></span></h3>
      <p id="history-source-status" aria-live="polite"></p>
      <pre class="admin-history-source-body" id="history-source-body"></pre>
      <div class="admin-edit-actions">
        <button type="button" class="cyber-btn cyber-btn-secondary" id="history-source-close">关闭</button>
      </div>
    </div>
    <div id="history-preview" hidden>
      <h3 class="admin-history-subtitle">版本预览 <span id="history-preview-title"></span></h3>
      <iframe id="history-preview-frame" class="admin-rendered-preview" sandbox="allow-downloads allow-forms allow-modals allow-popups allow-scripts" title="历史版本预览"></iframe>
      <div class="admin-edit-actions">
        <button type="button" class="cyber-btn cyber-btn-secondary" id="history-preview-close">关闭预览</button>
      </div>
    </div>
    <div id="history-restore" hidden>
      <h3 class="admin-history-subtitle">恢复版本 <span id="history-restore-title"></span></h3>
      <p id="history-restore-status" aria-live="polite"></p>
      <p class="admin-history-note">恢复会将所选版本的内容写入为新的当前 Revision，并记录恢复来源；若所选版本与当前内容相同，则不会产生新版本。当前密码、有效期、发布状态、收藏与浏览量不会改变。</p>
      <div class="admin-edit-actions">
        <button type="button" class="cyber-btn" id="history-restore-confirm">确认恢复</button>
        <button type="button" class="cyber-btn cyber-btn-secondary" id="history-restore-cancel">取消</button>
      </div>
    </div>
  </section>

  <section class="card admin-card" id="content-section">
    <div class="admin-content-header">
      <div class="admin-content-tabs" role="tablist" aria-label="内容视图">
        <button type="button" class="admin-tab active" id="tab-raw" role="tab" aria-controls="panel-raw" aria-selected="true" tabindex="0" data-tab="raw">
          <i class="fas fa-code" aria-hidden="true"></i>
          <span>原始内容</span>
        </button>
        <button type="button" class="admin-tab" id="tab-rendered" role="tab" aria-controls="panel-rendered" aria-selected="false" tabindex="-1" data-tab="rendered">
          <i class="fas fa-eye" aria-hidden="true"></i>
          <span>预览</span>
        </button>
      </div>
      <a class="admin-icon-link" href="<%= publicUrl %>" target="_blank" rel="noopener noreferrer" aria-label="打开公开页面">
        <i class="fas fa-external-link-alt" aria-hidden="true"></i>
      </a>
    </div>

    <div class="admin-tab-content">
      <div class="admin-tab-panel active" id="panel-raw" role="tabpanel" aria-labelledby="tab-raw" data-panel="raw">
        <textarea class="admin-content-viewer" id="content-textarea" readonly aria-label="原始内容"><%= sharedPage.htmlContent %></textarea>
      </div>
      <div class="admin-tab-panel" id="panel-rendered" role="tabpanel" aria-labelledby="tab-rendered" data-panel="rendered" hidden>
        <iframe id="rendered-preview" class="admin-rendered-preview" sandbox="allow-downloads allow-forms allow-modals allow-popups allow-scripts" title="内容预览"></iframe>
      </div>
    </div>
  </section>
</div>

<script type="application/json" id="page-data"><%- pageDataJson %></script>
<script src="/js/admin.js"></script>
<script src="/js/admin-favorite.js"></script>
<script src="/js/admin-time.js"></script>
<script src="/js/theme-sampler.js"></script>
<script src="/js/source-diff.js"></script>
<script src="/js/publish-intent.js"></script>
<script src="/js/admin-detail.js"></script>
<script src="/js/admin-history.js"></script>
<%- include('partials/footer', { page }) %>
