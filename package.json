{
  "name": "quickshare",
  "version": "1.0.0",
  "description": "QuickShare content sharing tool - Express version",
  "main": "server.js",
  "scripts": {
    "start": "NODE_ENV=production node --max-old-space-size=1024 server.js",
    "dev": "NODE_ENV=development nodemon server.js",
    "test": "NODE_ENV=test VERCEL_ENV= DATABASE_URL= POSTGRES_URL= node --test test/*.test.js",
    "test:postgres": "NODE_ENV=test node --test --test-concurrency=1 test/integration/postgres-migrations.test.js test/integration/postgres-maintenance.test.js test/integration/postgres-operations.test.js test/integration/postgres-revisions.test.js test/integration/postgres-history.test.js test/integration/postgres-purge.test.js test/integration/postgres-api-keys.test.js",
    "test:postgres:backup": "NODE_ENV=test node --test test/integration/postgres-backup.test.js",
    "prod": "NODE_ENV=production node --max-old-space-size=1024 server.js",
    "db:migrate": "node scripts/migrate.js",
    "maintenance": "node scripts/maintenance.js",
    "hash-password": "node scripts/hash-password.js",
    "backfill-titles": "node scripts/backfill-page-titles.js",
    "backfill-revisions": "node scripts/backfill-page-revisions.js",
    "backup:db": "node scripts/backup-db.js",
    "restore:db": "node scripts/restore-db.js",
    "verify:backup": "node scripts/verify-backup.js",
    "backup:check": "node scripts/backup-restore-check.js"
  },
  "keywords": [
    "html",
    "share",
    "express",
    "ejs"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "body-parser": "^1.20.3",
    "bytes": "3.1.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "diff": "9.0.0",
    "dotenv": "^16.4.7",
    "ejs": "^3.1.10",
    "express": "^4.21.2",
    "marked": "^15.0.7",
    "morgan": "^1.10.0",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  }
}
